// ==========================================
// 42_PIPE_CAP_POINTS
// V2.6A：生成顶部端头
//
// 资产：
// SM_Drains_01_Cap_01
//
// 规则：
// 1. 基于 pipe_anchor 生成
// 2. 每条竖管顶部生成 1 个端头
// 3. 端头不需要旋转参数
// 4. 只提供位置偏移参数
// ==========================================

int enable = chi("../enable_pipe_cap");

string cap_asset = "SM_Drains_01_Cap_01";
string cap_path  = "/Game/CityStreetStylizedPack/Environment/Props/Drains_01/SM_Drains_01_Cap_01.SM_Drains_01_Cap_01";

float offset_x = chf("../pipe_cap_offset_x_cm") / 100.0;
float offset_y = chf("../pipe_cap_offset_y_cm") / 100.0;
float offset_z = chf("../pipe_cap_offset_z_cm") / 100.0;

float tube_height_m = 1.0;

int src_count = npoints(0);
int cap_count = 0;

if (enable == 1)
{
    for (int i = 0; i < src_count; i++)
    {
        string module_type = point(0, "module_type", i);

        if (module_type != "pipe_anchor")
        {
            continue;
        }

        vector anchor_pos = point(0, "P", i);

        int segment_count = point(0, "pipe_segment_count", i);
        segment_count = max(1, segment_count);

        string facade = point(0, "pipe_facade", i);

        vector wall_normal = point(0, "pipe_wall_normal", i);
        vector wall_tangent = point(0, "pipe_wall_tangent", i);

        // 管道顶部位置
        vector pos = anchor_pos;
        pos.y += float(segment_count) * tube_height_m;

        // 端头位置微调
        pos += set(offset_x, offset_y, offset_z);

        int pt = addpoint(0, pos);

        setpointattrib(0, "asset_id", pt, cap_asset, "set");
        setpointattrib(0, "module_type", pt, "pipe_cap", "set");
        setpointattrib(0, "unreal_instance", pt, cap_path, "set");

        setpointattrib(0, "facade", pt, facade, "set");
        setpointattrib(0, "pipe_facade", pt, facade, "set");

        setpointattrib(0, "pipe_run_id", pt, i, "set");
        setpointattrib(0, "pipe_segment_count", pt, segment_count, "set");

        setpointattrib(0, "pipe_wall_normal", pt, wall_normal, "set");
        setpointattrib(0, "pipe_wall_tangent", pt, wall_tangent, "set");

        setpointattrib(0, "width_cm", pt, 67.0, "set");
        setpointattrib(0, "depth_cm", pt, 67.0, "set");
        setpointattrib(0, "height_cm", pt, 62.0, "set");
        setpointattrib(0, "thickness_cm", pt, 67.0, "set");

        setpointattrib(0, "grid_width", pt, 1, "set");
        setpointattrib(0, "grid_depth", pt, 1, "set");

        // 顶部端头不需要旋转
        vector4 q = quaternion(radians(0.0), set(0, 1, 0));
        setpointattrib(0, "orient", pt, q, "set");
        setpointattrib(0, "rot_y_deg", pt, 0.0, "set");

        setpointattrib(0, "scale", pt, set(1, 1, 1), "set");
        setpointattrib(0, "pscale", pt, 1.0, "set");

        setpointattrib(0, "asset_table_found", pt, 1, "set");
        setpointattrib(0, "asset_table_status", pt, "pipe_manual", "set");
        setpointattrib(0, "table_module_type", pt, "pipe_cap", "set");
        setpointattrib(0, "table_unreal_asset_path", pt, cap_path, "set");

        setpointattrib(0, "Cd", pt, set(0.9, 0.1, 1.0), "set");

        cap_count++;
    }
}

// 删除输入 anchor，只保留 cap 点
for (int i = src_count - 1; i >= 0; i--)
{
    removepoint(0, i);
}

setdetailattrib(0, "pipe_cap_count", cap_count, "set");