// ==========================================
// 09E_UPPER_WINDOW_REPLACE
// V2：二楼及以上 front 高层窗墙替换
//
// 当前规则：
// 1. 只处理 global_floor > 0
// 2. 只处理 facade = front
// 3. 只替换 plain_wall
// 4. 只使用 300x200 高层窗墙
// 5. 不处理 corner_wall，所以不会占用转角
// ==========================================


void add_upper_module(
    const int geo;
    const int start_x;
    const int z;
    const float unit;
    const float floor_bottom_y;
    const float floor_height;
    const int global_floor;
    const string facade;
    const float rot_y;
    const int module_grid;
    const int make_window;
    const string source_tag;
    const int variant_seed;
    const int variant_mode;
    const float window01_weight)
{
    string asset_id = "";
    string path = "";
    string module_type = "plain_wall";

    if (make_window == 1)
    {
        int variant_index = 0;
    
        float w01 = max(1.0, window01_weight);
        float w02 = 1.0;
        float w03 = 1.0;
        float w04 = 1.0;
    
        float total_weight = w01 + w02 + w03 + w04;
    
        float rv = 0.0;
    
        if (variant_mode == 1)
        {
            // Full Random：每个窗位独立随机
            rv = rand(
                float(variant_seed) +
                float(start_x) * 17.31 +
                float(z) * 23.77 +
                float(global_floor) * 41.19
            );
        }
        else if (variant_mode == 2)
        {
            // Vertical Columns：同一 X 列尽量保持同一种窗墙
            rv = rand(
                float(variant_seed) +
                float(start_x) * 19.73
            );
        }
        else
        {
            // Default Only
            rv = 0.0;
        }
    
        float pick = rv * total_weight;
    
        if (variant_mode == 0)
        {
            variant_index = 0;
        }
        else if (pick < w01)
        {
            variant_index = 0;
        }
        else if (pick < w01 + w02)
        {
            variant_index = 1;
        }
        else if (pick < w01 + w02 + w03)
        {
            variant_index = 2;
        }
        else
        {
            variant_index = 3;
        }
    
        if (variant_index == 0)
        {
            asset_id = "SM_Building_01_WallWindow_300x200_01";
            path = "/Game/CityStreetStylizedPack/Environment/Architecture/Building_01/SM_Building_01_WallWindow_300x200_01.SM_Building_01_WallWindow_300x200_01";
        }
        else if (variant_index == 1)
        {
            asset_id = "SM_Building_01_WallWindow_300x200_02";
            path = "/Game/CityStreetStylizedPack/Environment/Architecture/Building_01/SM_Building_01_WallWindow_300x200_02.SM_Building_01_WallWindow_300x200_02";
        }
        else if (variant_index == 2)
        {
            asset_id = "SM_Building_01_WallWindow_300x200_03";
            path = "/Game/CityStreetStylizedPack/Environment/Architecture/Building_01/SM_Building_01_WallWindow_300x200_03.SM_Building_01_WallWindow_300x200_03";
        }
        else
        {
            asset_id = "SM_Building_01_WallWindow_300x200_04";
            path = "/Game/CityStreetStylizedPack/Environment/Architecture/Building_01/SM_Building_01_WallWindow_300x200_04.SM_Building_01_WallWindow_300x200_04";
        }
    
        module_type = "window_wall_upper";
    }
    else
    {
        if (module_grid == 1)
        {
            asset_id = "SM_Building_01_Wall_300x100_01";
            path = "/Game/CityStreetStylizedPack/Environment/Architecture/Building_01/SM_Building_01_Wall_300x100_01.SM_Building_01_Wall_300x100_01";
        }
        else
        {
            asset_id = "SM_Building_01_Wall_300x200_01";
            path = "/Game/CityStreetStylizedPack/Environment/Architecture/Building_01/SM_Building_01_Wall_300x200_01.SM_Building_01_Wall_300x200_01";
        }

        module_type = "plain_wall";
    }

    vector pos = set(float(start_x) * unit, floor_bottom_y, float(z) * unit);

    int pt = addpoint(geo, pos);

    setpointattrib(geo, "asset_id", pt, asset_id, "set");
    setpointattrib(geo, "module_type", pt, module_type, "set");
    setpointattrib(geo, "unreal_instance", pt, path, "set");

    setpointattrib(geo, "facade", pt, facade, "set");
    setpointattrib(geo, "global_floor", pt, global_floor, "set");

    setpointattrib(geo, "grid_width", pt, module_grid, "set");
    setpointattrib(geo, "width_cm", pt, float(module_grid) * 100.0, "set");
    setpointattrib(geo, "height_cm", pt, floor_height * 100.0, "set");
    setpointattrib(geo, "depth_cm", pt, 25.0, "set");
    setpointattrib(geo, "thickness_cm", pt, 25.0, "set");

    setpointattrib(geo, "floor_bottom_y", pt, floor_bottom_y, "set");
    setpointattrib(geo, "floor_height", pt, floor_height, "set");

    setpointattrib(geo, "rot_y_deg", pt, rot_y, "set");
    setpointattrib(geo, "orient", pt, quaternion(radians(rot_y), set(0, 1, 0)), "set");
    setpointattrib(geo, "scale", pt, set(1, 1, 1), "set");

    setpointattrib(geo, "upper_window_source", pt, source_tag, "set");
}


// ===============================
// 参数
// ===============================

int enable_windows = chi("../enable_upper_windows");
int window_interval = max(1, chi("../upper_window_interval"));
int window_offset = chi("../upper_window_offset");

int variant_seed = chi("../upper_window_variant_seed");
int variant_mode = chi("../upper_window_variant_mode");
float window01_weight = max(1.0, chf("../upper_window_01_weight"));

float unit = chf("../grid_unit");

if (enable_windows == 0)
{
    setdetailattrib(0, "upper_window_status", "disabled", "set");
    return;
}

int src_count = npoints(0);


// ===============================
// 找高层 front 普通墙的最小 X
// 用来统一计算窗户节奏
// ===============================

int found_candidate = 0;
int pattern_min_x = 999999;

for (int i = 0; i < src_count; i++)
{
    string facade = point(0, "facade", i);
    string module_type = point(0, "module_type", i);
    int global_floor = point(0, "global_floor", i);
    int grid_width = point(0, "grid_width", i);

    if (
        facade == "front" &&
        module_type == "plain_wall" &&
        global_floor > 0 &&
        grid_width >= 2
    )
    {
        vector P = point(0, "P", i);
        int sx = int(floor(P.x / unit + 0.5));

        pattern_min_x = min(pattern_min_x, sx);
        found_candidate = 1;
    }
}

if (found_candidate == 0)
{
    setdetailattrib(0, "upper_window_status", "no_upper_front_plain_wall", "set");
    return;
}


// ===============================
// 遍历并替换
// ===============================

int geo_id = 0;

int created_window_count = 0;
int rebuilt_plain_count = 0;

int remove_ids[];

for (int i = 0; i < src_count; i++)
{
    string facade = point(0, "facade", i);
    string module_type = point(0, "module_type", i);
    int global_floor = point(0, "global_floor", i);
    int grid_width = point(0, "grid_width", i);

    if (
        facade != "front" ||
        module_type != "plain_wall" ||
        global_floor <= 0 ||
        grid_width < 2
    )
    {
        continue;
    }

    vector P = point(0, "P", i);

    int start_x = int(floor(P.x / unit + 0.5));
    int z = int(floor(P.z / unit + 0.5));

    float floor_bottom_y = point(0, "floor_bottom_y", i);
    float floor_height = point(0, "floor_height", i);
    float rot_y = point(0, "rot_y_deg", i);

    int used = 0;

    while (used < grid_width)
    {
        int remain = grid_width - used;
        int module_grid = 1;

        if (remain >= 2)
        {
            module_grid = 2;
        }
        else
        {
            module_grid = 1;
        }

        int slot_start_x = start_x + used;
        int make_window = 0;

        if (module_grid == 2)
        {
            int slot_index = int(floor(float(slot_start_x - pattern_min_x) / 2.0));

            if (((slot_index + window_offset + global_floor) % window_interval) == 0)
            {
                make_window = 1;
            }
        }

        string source_tag = "upper_plain_rebuild";

        if (make_window == 1)
        {
            source_tag = "upper_window_replace";
            created_window_count++;
        }
        else
        {
            rebuilt_plain_count++;
        }

        add_upper_module(
            geo_id,
            slot_start_x,
            z,
            unit,
            floor_bottom_y,
            floor_height,
            global_floor,
            facade,
            rot_y,
            module_grid,
            make_window,
            source_tag,
            variant_seed,
            variant_mode,
            window01_weight
            );

        used += module_grid;
    }

    append(remove_ids, i);
}


// 删除被重建的原高层普通墙点
for (int r = len(remove_ids) - 1; r >= 0; r--)
{
    int remove_pt = remove_ids[r];
    removepoint(0, remove_pt);
}

setdetailattrib(0, "upper_window_status", "upper_windows_created", "set");
setdetailattrib(0, "upper_window_created_count", created_window_count, "set");
setdetailattrib(0, "upper_window_rebuilt_plain_count", rebuilt_plain_count, "set");