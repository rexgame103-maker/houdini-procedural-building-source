// ==========================================
// 40_PIPE_CONNECTOR_POINTS
// V2.6A：生成直管之间的接缝 / 卡箍环
//
// 当前只生成：
// SM_Drains_01_Connecror_01
//
// 说明：
// 1. 基于 pipe_anchor 生成
// 2. 只放在直管段之间
// 3. 不处理底部弯头两个接口
// ==========================================

int enable = chi("../enable_pipe_connectors");

string connector_asset = "SM_Drains_01_Connecror_01";
string connector_path  = "/Game/CityStreetStylizedPack/Environment/Props/Drains_01/SM_Drains_01_Connecror_01.SM_Drains_01_Connecror_01";

float offset_x = chf("../pipe_connector_offset_x_cm") / 100.0;
float offset_y = chf("../pipe_connector_offset_y_cm") / 100.0;
float offset_z = chf("../pipe_connector_offset_z_cm") / 100.0;

float rot_x = chf("../pipe_connector_rot_x");
float rot_y = chf("../pipe_connector_rot_y");
float rot_z = chf("../pipe_connector_rot_z");

float tube_height_m = 1.0;

int src_count = npoints(0);
int connector_count = 0;

if (enable == 1)
{
    for (int i = 0; i < src_count; i++)
    {
        string module_type = point(0, "module_type", i);

        if (module_type != "pipe_anchor")
        {
            continue;
        }

        vector anchor_pos = point(0, "P", i);

        int segment_count = point(0, "pipe_segment_count", i);
        segment_count = max(1, segment_count);

        string facade = point(0, "pipe_facade", i);

        vector wall_normal = point(0, "pipe_wall_normal", i);
        vector wall_tangent = point(0, "pipe_wall_tangent", i);

        // 直管之间的卡箍：
        // 如果有 5 节直管，则在 1,2,3,4 米位置放 4 个卡箍
        for (int s = 1; s < segment_count; s++)
        {
            vector pos = anchor_pos;
            pos.y += float(s) * tube_height_m;

            pos += set(offset_x, offset_y, offset_z);

            int pt = addpoint(0, pos);

            setpointattrib(0, "asset_id", pt, connector_asset, "set");
            setpointattrib(0, "module_type", pt, "pipe_connector", "set");
            setpointattrib(0, "unreal_instance", pt, connector_path, "set");

            setpointattrib(0, "facade", pt, facade, "set");
            setpointattrib(0, "pipe_facade", pt, facade, "set");

            setpointattrib(0, "pipe_run_id", pt, i, "set");
            setpointattrib(0, "pipe_connector_index", pt, s, "set");
            setpointattrib(0, "pipe_segment_count", pt, segment_count, "set");

            setpointattrib(0, "pipe_wall_normal", pt, wall_normal, "set");
            setpointattrib(0, "pipe_wall_tangent", pt, wall_tangent, "set");

            setpointattrib(0, "width_cm", pt, 47.0, "set");
            setpointattrib(0, "depth_cm", pt, 47.0, "set");
            setpointattrib(0, "height_cm", pt, 4.0, "set");
            setpointattrib(0, "thickness_cm", pt, 4.0, "set");

            setpointattrib(0, "grid_width", pt, 1, "set");
            setpointattrib(0, "grid_depth", pt, 1, "set");

            vector4 qx = quaternion(radians(rot_x), set(1, 0, 0));
            vector4 qy = quaternion(radians(rot_y), set(0, 1, 0));
            vector4 qz = quaternion(radians(rot_z), set(0, 0, 1));

            vector4 q = qy * qx * qz;

            setpointattrib(0, "orient", pt, q, "set");
            setpointattrib(0, "rot_y_deg", pt, rot_y, "set");

            setpointattrib(0, "scale", pt, set(1, 1, 1), "set");
            setpointattrib(0, "pscale", pt, 1.0, "set");

            setpointattrib(0, "asset_table_found", pt, 1, "set");
            setpointattrib(0, "asset_table_status", pt, "pipe_manual", "set");
            setpointattrib(0, "table_module_type", pt, "pipe_connector", "set");
            setpointattrib(0, "table_unreal_asset_path", pt, connector_path, "set");

            setpointattrib(0, "Cd", pt, set(1.0, 0.8, 0.1), "set");

            connector_count++;
        }
    }
}

// 删除输入 anchor，只保留 connector 点
for (int i = src_count - 1; i >= 0; i--)
{
    removepoint(0, i);
}

setdetailattrib(0, "pipe_connector_count", connector_count, "set");