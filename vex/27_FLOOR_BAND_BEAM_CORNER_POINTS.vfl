// ==========================================
// 27_FLOOR_BAND_BEAM_CORNER_POINTS
// V2.1B：楼层横梁转角生成
//
// 输入：06_EXPOSED_EDGE_DETECTION
// 输出：横梁转角模块点
//
// 规则：
// 1. 一楼与二楼交界处使用 50cm Cornice 转角横梁
// 2. 二层以上使用 12cm DecorTrim 转角横梁
// 3. 只在同一个 cell 同时有两个相邻 exposed edge 时生成
// 4. 旋转先按屋檐角逻辑，再整体 +90 度
// ==========================================

function int corner_exists(
    const int corner_x[];
    const int corner_z[];
    const int corner_floor[];
    const string corner_name[];
    const int test_x;
    const int test_z;
    const int test_floor;
    const string test_name)
{
    for (int i = 0; i < len(corner_x); i++)
    {
        if (
            corner_x[i] == test_x &&
            corner_z[i] == test_z &&
            corner_floor[i] == test_floor &&
            corner_name[i] == test_name
        )
        {
            return 1;
        }
    }

    return 0;
}


void add_beam_corner(
    int geo;
    int cx;
    int cz;
    float unit;
    float beam_y;
    int global_floor;
    string cname;
    float base_rot;
    int is_ground_band)
{
    string asset_id = "";
    string path = "";
    string module_type = "";

    float h_cm = 12.0;
    float d_cm = 4.0;

    if (is_ground_band == 1)
    {
        asset_id = "SM_Building_01_Cornice_CRN_50x100_01";
        path = "/Game/CityStreetStylizedPack/Environment/Architecture/Building_01/SM_Building_01_Cornice_CRN_50x100_01.SM_Building_01_Cornice_CRN_50x100_01";

        module_type = "ground_floor_band_beam_corner";
        h_cm = 50.0;
        d_cm = 47.0;
    }
    else
    {
        asset_id = "SM_Building_01_DecorTrim_CRN_12x100_01";
        path = "/Game/CityStreetStylizedPack/Environment/Architecture/Building_01/SM_Building_01_DecorTrim_CRN_12x100_01.SM_Building_01_DecorTrim_CRN_12x100_01";

        module_type = "floor_band_beam_corner";
        h_cm = 12.0;
        d_cm = 4.0;
    }

    vector pos = set(float(cx) * unit, beam_y, float(cz) * unit);

    int pt = addpoint(geo, pos);

    setpointattrib(geo, "asset_id", pt, asset_id, "set");
    setpointattrib(geo, "module_type", pt, module_type, "set");
    setpointattrib(geo, "unreal_instance", pt, path, "set");

    setpointattrib(geo, "facade", pt, "corner", "set");
    setpointattrib(geo, "corner_name", pt, cname, "set");
    setpointattrib(geo, "global_floor", pt, global_floor, "set");

    setpointattrib(geo, "floor_band_after_global_floor", pt, global_floor, "set");
    setpointattrib(geo, "floor_band_y", pt, beam_y, "set");

    setpointattrib(geo, "grid_width", pt, 1, "set");
    setpointattrib(geo, "grid_depth", pt, 1, "set");

    setpointattrib(geo, "width_cm", pt, 100.0, "set");
    setpointattrib(geo, "depth_cm", pt, d_cm, "set");
    setpointattrib(geo, "height_cm", pt, h_cm, "set");
    setpointattrib(geo, "thickness_cm", pt, d_cm, "set");

    setpointattrib(geo, "pivot_type", pt, "left_bottom_depth_center", "set");

    // 转角横梁真实资产需要在原基础上再向左旋转 90 度
    float final_rot_y = base_rot + 180.0;

    setpointattrib(geo, "rot_y_deg", pt, final_rot_y, "set");
    setpointattrib(geo, "orient", pt, quaternion(radians(final_rot_y), set(0, 1, 0)), "set");
    setpointattrib(geo, "scale", pt, set(1, 1, 1), "set");
}


// ===============================
// 参数
// ===============================

int enable_beam = chi("../enable_floor_band_beam");

int interval = max(1, chi("../floor_band_beam_interval"));
int start_floor = max(2, chi("../floor_band_beam_start_floor"));

float ground_beam_y_offset = chf("../ground_floor_band_beam_y_offset_cm") / 100.0;
float upper_beam_y_offset  = chf("../upper_floor_band_beam_y_offset_cm") / 100.0;

float unit = chf("../grid_unit");

int src_count = npoints(0);
int created_count = 0;

// ===============================
// 找到整体最高楼层
// 只过滤整体顶楼，不过滤下层退台屋顶
// ===============================

int max_global_floor = -999999;

for (int i = 0; i < src_count; i++)
{
    int gf = point(0, "global_floor", i);
    max_global_floor = max(max_global_floor, gf);
}

if (enable_beam == 0)
{
    for (int i = src_count - 1; i >= 0; i--)
    {
        removepoint(0, i);
    }

    setdetailattrib(0, "floor_band_beam_corner_status", "disabled", "set");
    setdetailattrib(0, "floor_band_beam_corner_created_count", 0, "set");
    return;
}


// ===============================
// 去重缓存
// ===============================

int corner_x[];
int corner_z[];
int corner_floor[];
string corner_name[];


// ===============================
// 遍历 exposed cell，生成转角候选
// ===============================

for (int i = 0; i < src_count; i++)
{
    int x = point(0, "cell_x", i);
    int z = point(0, "cell_z", i);

    int global_floor = point(0, "global_floor", i);
    int human_floor = global_floor + 1;
    // 整体顶楼不生成转角横梁
    if (global_floor == max_global_floor)
    {
        continue;
    }

    float floor_top_y = point(0, "floor_top_y", i);

    int is_ground_band = 0;
    int make_beam = 0;

    if (global_floor == 0)
    {
        make_beam = 1;
        is_ground_band = 1;
    }
    else
    {
        if (human_floor >= start_floor)
        {
            if (((human_floor - start_floor) % interval) == 0)
            {
                make_beam = 1;
                is_ground_band = 0;
            }
        }
    }

    if (make_beam == 0)
    {
        continue;
    }

    float beam_y = floor_top_y;

    if (is_ground_band == 1)
    {
        beam_y += ground_beam_y_offset;
    }
    else
    {
        beam_y += upper_beam_y_offset;
    }

    int ef = point(0, "exposed_front", i);
    int eb = point(0, "exposed_back", i);
    int el = point(0, "exposed_left", i);
    int er = point(0, "exposed_right", i);

    // front + left
    if (ef == 1 && el == 1)
    {
        string cname = "front_left_band_corner";

        if (corner_exists(corner_x, corner_z, corner_floor, corner_name, x, z, global_floor, cname) == 0)
        {
            append(corner_x, x);
            append(corner_z, z);
            append(corner_floor, global_floor);
            append(corner_name, cname);

            add_beam_corner(0, x, z, unit, beam_y, global_floor, cname, 0.0, is_ground_band);
            created_count++;
        }
    }

    // front + right
    if (ef == 1 && er == 1)
    {
        string cname = "front_right_band_corner";

        if (corner_exists(corner_x, corner_z, corner_floor, corner_name, x + 1, z, global_floor, cname) == 0)
        {
            append(corner_x, x + 1);
            append(corner_z, z);
            append(corner_floor, global_floor);
            append(corner_name, cname);

            add_beam_corner(0, x + 1, z, unit, beam_y, global_floor, cname, -90.0, is_ground_band);
            created_count++;
        }
    }

    // back + right
    if (eb == 1 && er == 1)
    {
        string cname = "back_right_band_corner";

        if (corner_exists(corner_x, corner_z, corner_floor, corner_name, x + 1, z + 1, global_floor, cname) == 0)
        {
            append(corner_x, x + 1);
            append(corner_z, z + 1);
            append(corner_floor, global_floor);
            append(corner_name, cname);

            add_beam_corner(0, x + 1, z + 1, unit, beam_y, global_floor, cname, 180.0, is_ground_band);
            created_count++;
        }
    }

    // back + left
    if (eb == 1 && el == 1)
    {
        string cname = "back_left_band_corner";

        if (corner_exists(corner_x, corner_z, corner_floor, corner_name, x, z + 1, global_floor, cname) == 0)
        {
            append(corner_x, x);
            append(corner_z, z + 1);
            append(corner_floor, global_floor);
            append(corner_name, cname);

            add_beam_corner(0, x, z + 1, unit, beam_y, global_floor, cname, 90.0, is_ground_band);
            created_count++;
        }
    }
}


// 删除原始 occupancy 点，只保留横梁转角点
for (int i = src_count - 1; i >= 0; i--)
{
    removepoint(0, i);
}


setdetailattrib(0, "floor_band_beam_corner_status", "corner_points_created", "set");
setdetailattrib(0, "floor_band_beam_corner_created_count", created_count, "set");