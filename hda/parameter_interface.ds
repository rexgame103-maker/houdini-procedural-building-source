        name    "xn__BuildingGeneration_cra_2"
        label   "03 Debug Preview"
        invisibletab
        grouptag { "export_disable" "1" }

        group {
            name    "stdswitcher4_3_4"
            label   "05 Debug Preview"

            parm {
                name    "show_block_proxy"
                label   "Show Block Proxy"
                type    toggle
                default { "1" }
                parmtag { "script_callback_language" "python" }
            }
        }

    }

}
